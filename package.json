{
  "name": "opencodex",
  "version": "2.2.1",
  "description": "OpenCodex - The Unified Codex Desktop Unlocker, Custom Model Gateway & Computer Use Router",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:windows": "node scripts/build.mjs --windows",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "postinstall": "tsc",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
